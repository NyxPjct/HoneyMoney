# HoneyMoney — copy to apps/web/.env.local (and export the same vars for apps/worker when self-hosting).
# Never commit real values.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Published pages are served at https://<slug>.<this domain>. Leave empty in development
# (pages are then served at /sites/<slug> on the app domain).
NEXT_PUBLIC_PAGES_DOMAIN=

# --- Supabase (values printed by `pnpm db:start`) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inngest (agent queue) --------------------------------------------------
# Local: run `pnpm dev`, which also starts the Inngest dev server. INNGEST_DEV=1 sends events to it.
INNGEST_DEV=1
# Production: from app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Free model offered by this instance (optional) -------------------------
# When INSTANCE_AI_KEY is empty, users must bring their own key.
INSTANCE_AI_PROVIDER=google
INSTANCE_AI_MODEL=gemini-3.8-flash
INSTANCE_AI_KEY=
# Agent runs per user per day on the free model (one offer is ~6–9 runs).
INSTANCE_DAILY_RUN_LIMIT=40

# --- Limits ------------------------------------------------------------------
# Agent runs per user per hour, any key.
GENERATION_HOURLY_LIMIT=60

# --- Model overrides for users' own keys (optional) ------------------------
# GOOGLE_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Analytics (optional, only loaded after consent) -----------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Google login (optional) -------------------------------------------------
# Show the "Continuar com Google" button only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Local Supabase only:
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
